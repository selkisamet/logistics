// Tesellüm & WMS — Prisma şeması (PostgreSQL)
// Domain enum değerleri @lojistik/shared/enums ile birebir hizalıdır.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SUPERVISOR
  OPERATOR
}

enum ShipmentStatus {
  DRAFT
  EXPECTED
  IN_RECEIVING
  COMPLETED
  CANCELLED
}

enum ReceiptStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DiscrepancyType {
  SHORTAGE
  OVERAGE
  DAMAGE
  WRONG_ITEM
  OTHER
}

enum PackageType {
  CARTON
  PALLET
  CASE
  UNIT
  DRUM
  BAG
  BIGBAG
  OTHER
}

enum DispatchStatus {
  DRAFT
  DISPATCHED
  CANCELLED
}


model User {
  id           String   @id @default(cuid())
  email        String   @unique
  fullName     String
  passwordHash String
  role         UserRole @default(OPERATOR)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  startedReceipts Receipt[]      @relation("ReceiptStartedBy")
  discrepancies   Discrepancy[]  @relation("DiscrepancyCreatedBy")
  dispatches      Dispatch[]     @relation("DispatchBy")
  auditEvents     AuditEvent[]
}

model Customer {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  taxOffice   String? // vergi dairesi
  taxNumber   String? // vergi numarası
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shipments          InboundShipment[]   @relation("ShipmentSender")
  recipientShipments InboundShipment[]   @relation("ShipmentRecipient")
  receipts           Receipt[]
  sourceLocations    CustomerLocation[]
  recipients         CustomerRecipient[]
  contacts           CustomerContact[]
  dispatchStops      DispatchStop[]      @relation("StopCustomer")
}

// Müşteri yetkili kişileri (çoklu) — ad, görev, telefon, e-posta, dahili
model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  role       String? // görev/ünvan
  phone      String?
  email      String?
  extension  String? // dahili
  createdAt  DateTime @default(now())

  @@index([customerId])
}

// Müşteriye ait kaynak depo/adres (malın alınacağı yer - pickup)
model CustomerLocation {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  address    String?
  phone      String?
  createdAt  DateTime @default(now())

  shipmentSources            ShipmentSource[]
  shipmentRecipientLocations ShipmentRecipient[]
  dispatchStops              DispatchStop[]

  @@index([customerId])
}

// Müşteriye ait alıcı (firmanın kendi müşterisi - malın gideceği taraf)
model CustomerRecipient {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  address    String?
  phone      String?
  createdAt  DateTime @default(now())

  shipmentRecipients ShipmentRecipient[]

  @@index([customerId])
}

model Warehouse {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  address   String?
  isDefault Boolean  @default(false) // ön ihbarda ön-seçili gelen depo
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations Location[]
  shipments InboundShipment[]
  receipts  Receipt[]
}

model Location {
  id          String   @id @default(cuid())
  code        String
  description String?
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([warehouseId, code])
}

// ASN / Ön İhbar — beklenen sevkiyat
model InboundShipment {
  id             String         @id @default(cuid())
  reference      String         @unique
  status         ShipmentStatus @default(EXPECTED)
  customerId     String
  customer       Customer       @relation("ShipmentSender", fields: [customerId], references: [id])
  // Alıcı = kayıtlı bir Müşteri (opsiyonel); lokasyonları boşaltma yerleri olur
  recipientCustomerId String?
  recipientCustomer   Customer?  @relation("ShipmentRecipient", fields: [recipientCustomerId], references: [id])
  warehouseId    String
  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id])
  vehicleId      String?
  vehicle        Vehicle?       @relation(fields: [vehicleId], references: [id])
  expectedAt     DateTime?
  notes          String?
  // Fiş için taraf/adres/ödeme bilgileri (hepsi opsiyonel — kör kabul/eski akış etkilenmez)
  principalName    String? // DORMANT: "İşi Veren/Cari" alanı kaldırıldı (kolon duruyor, yazılmıyor/okunmuyor)
  loadAddress      String? // yükleme (gönderici) adresi
  deliveryAddress  String? // teslimat (alıcı) adresi
  paymentType      String? // 'SENDER' | 'RECIPIENT'
  showAmountOnSlip Boolean @default(false) // gönderici ödemeli iken ücret fişte görünsün mü
  vatIncluded      Boolean @default(false) // girilen birim fiyatlar KDV dahil mi
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  lines      ShipmentLine[]
  sources    ShipmentSource[]
  recipients ShipmentRecipient[]
  receipts   Receipt[]

  @@index([vehicleId])
  @@index([recipientCustomerId])
}

// Araç havuzu: plaka, şoför, tip, dorse (tır için)
model Vehicle {
  id           String   @id @default(cuid())
  plate        String   @unique
  type         String   @default("Kamyon") // serbest metin (Tır, Kamyon, Kırkayak...)
  driverName   String?
  driverPhone  String?
  trailerPlate String? // dorse plakası (tır)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  shipments  InboundShipment[]
  dispatches Dispatch[]
}

// Bir ön ihbarın kaynak depoları (çoklu). Kayıtlı müşteri deposu ya da serbest metin.
model ShipmentSource {
  id                 String            @id @default(cuid())
  shipmentId         String
  shipment           InboundShipment   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  customerLocationId String?
  customerLocation   CustomerLocation? @relation(fields: [customerLocationId], references: [id])
  label              String // görünen ad (kayıtlı depo adı kopyası veya elle girilen metin)
  address            String? // kayıtlı deponun adres kopyası (fişte yükleme noktası)

  @@index([shipmentId])
}

// Bir ön ihbarın alıcıları (çoklu). Kayıtlı müşteri alıcısı ya da serbest metin.
model ShipmentRecipient {
  id                  String             @id @default(cuid())
  shipmentId          String
  shipment            InboundShipment    @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  customerRecipientId String? // DORMANT (eski model; artık kullanılmıyor)
  customerRecipient   CustomerRecipient? @relation(fields: [customerRecipientId], references: [id])
  customerLocationId  String? // alıcı müşterinin boşaltma lokasyonu
  customerLocation    CustomerLocation?  @relation(fields: [customerLocationId], references: [id])
  label               String // görünen ad (lokasyon adı kopyası veya elle girilen metin)
  address             String? // lokasyon adres kopyası (fişte boşaltma noktası)

  @@index([shipmentId])
}

model ShipmentLine {
  id          String          @id @default(cuid())
  shipmentId  String
  shipment    InboundShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  sku         String
  description String
  expectedQty Int
  unit        String          @default("ADET")
  barcode     String?
  unitPrice   Decimal?        @db.Decimal(12, 2) // birim fiyat (opsiyonel)

  receiptLines ReceiptLine[]
}

// Tesellüm — fiziksel mal kabul oturumu
model Receipt {
  id          String        @id @default(cuid())
  reference   String        @unique
  status      ReceiptStatus @default(IN_PROGRESS)
  shipmentId  String?
  shipment    InboundShipment? @relation(fields: [shipmentId], references: [id])
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id])
  warehouseId String
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id])
  notes       String?
  waybillNo   String? // irsaliye numarası (elle girilir)
  orderNo     String? // sipariş numarası (irsaliyede yer alır, elle girilir)
  startedById String?
  startedBy   User?         @relation("ReceiptStartedBy", fields: [startedById], references: [id])
  startedAt   DateTime      @default(now())
  completedAt DateTime?
  // DORMANT (kabul düzeyi sevk): artık yazılmaz — sevk DispatchItem defterinden yürür.
  // Kolonlar eski kayıtlar ve iptal temizliği için duruyor.
  dispatchedAt DateTime?
  dispatchId  String?
  dispatch    Dispatch?     @relation(fields: [dispatchId], references: [id])
  stopId      String?
  stop        DispatchStop? @relation(fields: [stopId], references: [id])

  lines         ReceiptLine[]
  packages      Package[]
  discrepancies Discrepancy[]
  dispatchItems DispatchItem[]

  @@index([dispatchId])
  @@index([stopId])
}

// Sevkiyat (çıkış) — depodaki kabulleri araca yükleyip çıkış
model Dispatch {
  id             String         @id @default(cuid())
  reference      String         @unique
  status         DispatchStatus @default(DRAFT)
  destination    String // nereye / alıcı
  vehiclePlate   String? // serbest metin (kayıtsız araç için)
  driverName     String?
  vehicleId      String?
  vehicle        Vehicle?       @relation(fields: [vehicleId], references: [id])
  notes          String?
  dispatchedById String?
  dispatchedBy   User?          @relation("DispatchBy", fields: [dispatchedById], references: [id])
  dispatchedAt   DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Taşıma İrsaliyesi (VUK 240/A) — matbu belgenin seri/sıra no'su ELLE girilir
  // (yasal numarayı anlaşmalı matbaa basar; uygulamanın SVK-... referansı yerine geçmez).
  waybillSerial      String? // matbu seri (ör. "A")
  waybillNo          String? // matbu sıra no (ör. "012345")
  waybillDate        DateTime? // düzenleme tarihi
  freightAmount      Decimal?  @db.Decimal(12, 2) // taşıma ücreti (elle girilir)
  freightVatIncluded Boolean   @default(false) // girilen ücret KDV dahil mi

  // items = sevkiyattaki yükün TEK defteri. packages/receipts bağları bunun AYNASIDIR
  // (QR okutma akışı ve eski kayıtlar için korunur) — yeni kod items üzerinden çalışır.
  items    DispatchItem[]
  receipts Receipt[] // DORMANT: kabul düzeyi sevk (artık yazılmıyor, DispatchItem kullanılır)
  packages Package[] // palet bazlı: sevkiyattaki paletler (items'ın aynası)
  stops    DispatchStop[] // çok duraklı teslimat noktaları (rota sırası)

  @@unique([waybillSerial, waybillNo]) // aynı yasal belge iki kez girilmesin
  @@index([vehicleId])
}

/// Sevkiyattaki tek bir yük satırı — "araçta ne var" sorusunun TEK kaynağı.
/// İki türü var (XOR — tam biri dolu, migration'da CHECK kısıtı var):
///  - `packageId` dolu  → KAP bazlı (QR'lı palet), qty her zaman 1
///  - `receiptLineId` dolu → KALEM bazlı (ürün + miktar), kısmi sevke izin verir
/// Bir kabul aynı anda İKİ türü birden kullanamaz (tek-granülerlik kuralı, serviste zorlanır):
/// paleti varsa kap bazlı, yoksa kalem bazlı.
model DispatchItem {
  id         String       @id @default(cuid())
  dispatchId String
  dispatch   Dispatch     @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  stopId     String? // hangi durakta inecek
  stop       DispatchStop? @relation(fields: [stopId], references: [id])
  receiptId  String // denormalize: gönderici/irsaliye no/depo belgede lazım
  receipt    Receipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  receiptLineId String?
  receiptLine   ReceiptLine? @relation(fields: [receiptLineId], references: [id], onDelete: Cascade)
  packageId     String?      @unique // bir palet en fazla bir sevkiyatta
  package       Package?     @relation(fields: [packageId], references: [id], onDelete: Cascade)

  qty         Int      @default(1)
  unit        String   @default("ADET") // kalem: ADET/KG · kap: PackageType
  description String // MALIN CİNSİ — snapshot (kayıt sonradan değişse belge sabit kalsın)
  createdAt   DateTime @default(now())

  @@index([dispatchId])
  @@index([receiptId])
  @@index([receiptLineId])
  @@index([stopId])
}

// Sevkiyattaki teslimat noktası (durak). Bir seferde birden çok müşteriye /
// bir müşterinin birden çok noktasına teslim yapılabilir.
model DispatchStop {
  id         String   @id @default(cuid())
  dispatchId String
  dispatch   Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  seq        Int // rota sırası (1, 2, 3...)
  // Alıcı = kayıtlı müşteri (opsiyonel; serbest metin de olabilir)
  customerId         String?
  customer           Customer?         @relation("StopCustomer", fields: [customerId], references: [id])
  customerLocationId String?
  customerLocation   CustomerLocation? @relation(fields: [customerLocationId], references: [id])
  // Snapshot (ShipmentSource/ShipmentRecipient deseni): kayıt sonradan değişse de belge sabit kalır
  name        String
  address     String?
  phone       String?
  note        String?
  deliveredAt DateTime? // durak teslim edildiğinde dolar
  createdAt   DateTime  @default(now())

  items    DispatchItem[]
  packages Package[] // items'ın aynası
  receipts Receipt[] // DORMANT

  @@index([dispatchId])
}

model ReceiptLine {
  id           String        @id @default(cuid())
  receiptId    String
  receipt      Receipt       @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  shipmentLineId String?
  shipmentLine ShipmentLine? @relation(fields: [shipmentLineId], references: [id])
  sku          String
  description  String
  expectedQty  Int?
  countedQty   Int           @default(0)
  unit         String        @default("ADET")
  barcode      String?
  unitPrice    Decimal?      @db.Decimal(12, 2) // ön ihbardan kopyalanır (fiş ÜCRET için)
  // Sevk edilen toplam (DispatchItem'ların toplamı — HER ZAMAN aynı transaction'da güncellenir).
  // Depoda kalan = countedQty - dispatchedQty. Denormalize: findStock tek sorguda çalışsın diye.
  dispatchedQty Int          @default(0)
  createdAt    DateTime      @default(now())

  discrepancies Discrepancy[]
  dispatchItems DispatchItem[]
}

// Koli/palet etiketi — QR ile izlenebilirlik
model Package {
  id        String      @id @default(cuid())
  code      String      @unique // QR'a basılan benzersiz kod
  type      PackageType @default(CARTON)
  sku       String?
  qty       Int?
  note      String?
  receiptId String
  receipt   Receipt     @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  // Palet bazlı sevkiyat: null ise depoda, doluysa sevk edilmiş/sevkiyata eklenmiş
  dispatchId   String?
  dispatch     Dispatch? @relation(fields: [dispatchId], references: [id])
  dispatchedAt DateTime?
  // Çok duraklı sevkiyatta bu palet hangi durakta inecek
  stopId String?
  stop   DispatchStop? @relation(fields: [stopId], references: [id])
  // Bu paletin sevkiyat defterindeki karşılığı (varsa)
  dispatchItem DispatchItem?

  @@index([dispatchId])
  @@index([stopId])
}

// Fark / tutanak (eksik / fazla / hasar)
model Discrepancy {
  id            String          @id @default(cuid())
  receiptId     String
  receipt       Receipt         @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  receiptLineId String?
  receiptLine   ReceiptLine?    @relation(fields: [receiptLineId], references: [id])
  type          DiscrepancyType
  qty           Int?
  description   String
  createdById   String?
  createdBy     User?           @relation("DiscrepancyCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime        @default(now())

  attachments Attachment[]
}

model Attachment {
  id            String       @id @default(cuid())
  url           String
  fileName      String
  mimeType      String
  discrepancyId String?
  discrepancy   Discrepancy? @relation(fields: [discrepancyId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
}

// İzlenebilirlik / denetim kaydı
model AuditEvent {
  id         String   @id @default(cuid())
  action     String // ör: receipt.completed, asn.created
  entityType String
  entityId   String
  metadata   Json?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

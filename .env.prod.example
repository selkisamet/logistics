# Sunucuda `.env` adıyla kopyala ve doldur. GİT'E GİRMEZ.
#   cp .env.prod.example .env && nano .env

DOMAIN=lojistik.enderlojistik.com

# Güçlü parola üret:  openssl rand -base64 32
POSTGRES_PASSWORD=

# JWT imza anahtarı — DEĞİŞTİRİRSEN herkesin oturumu düşer.
#   openssl rand -base64 48
JWT_SECRET=

# İrsaliye No / Sipariş No okuyan dar OCR için. Boş bırakılırsa OCR düğmesi hata verir,
# uygulamanın geri kalanı normal çalışır.
ANTHROPIC_API_KEY=
